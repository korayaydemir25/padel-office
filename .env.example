# Claude API anahtarı (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Model katmanları (değiştirmek istersen)
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# Instagram Graph API (boş bırakırsan yayın DRY-RUN modunda çalışır)
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v23.0

# output/ klasörünün internetten erişilebildiği adres (S3, Cloudinary, kendi siten...)
PUBLIC_MEDIA_BASE_URL=https://cdn.ornekpadel.com/ig
